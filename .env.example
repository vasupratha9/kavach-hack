# Copy to .env for local runs. Never commit real keys.
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Comma-separated: first is preferred, the rest are automatic fallbacks
GEMINI_MODEL=gemini-3.5-flash,gemini-3.5-flash-lite
# Google Search grounding for seller reputation ("off" to disable)
GEMINI_SEARCH=on
# Optional: Google Safe Browsing API key (Google Cloud console, free)
SAFE_BROWSING_API_KEY=
PORT=8080
